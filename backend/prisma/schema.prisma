generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  PROPOSAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String   @id @default(uuid()) @db.VarChar(36)
  name              String   @db.VarChar(255)
  email             String   @unique @db.VarChar(255)
  phone             String   @unique @db.VarChar(50)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  role              UserRole @default(CLIENT)
  avatarUrl         String?  @map("avatar_url") @db.LongText
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  providerProfile   ProviderProfile?
  verifications     UserVerification[]
  clientRequests    ServiceRequest[]   @relation("ClientRequests")
  providerRequests   ServiceRequest[]   @relation("ProviderRequests")
  sentMessages      ChatMessage[]      @relation("SentMessages")
  chatRoomsAsClient ChatRoom[]         @relation("ChatClient")
  chatRoomsAsProvider ChatRoom[]       @relation("ChatProvider")
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")

  @@map("users")
}

model UserVerification {
  id                String              @id @default(uuid()) @db.VarChar(36)
  userId            String              @map("user_id") @db.VarChar(36)
  documentType      String              @map("document_type") @db.VarChar(50)
  documentNumberEncrypted String         @map("document_number_encrypted") @db.VarChar(500)
  documentFrontUrl  String?             @map("document_front_url") @db.VarChar(500)
  documentBackUrl   String?             @map("document_back_url") @db.VarChar(500)
  selfieUrl         String?             @map("selfie_url") @db.VarChar(500)
  status            VerificationStatus  @default(PENDING)
  rejectionReason   String?             @map("rejection_reason") @db.Text
  reviewedAt        DateTime?           @map("reviewed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_verifications")
}

model Category {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  iconUrl     String?  @map("icon_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  providers   ProviderCategory[]
  serviceRequests ServiceRequest[]

  @@map("categories")
}

model ProviderProfile {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String   @unique @map("user_id") @db.VarChar(36)
  bio              String?  @db.Text
  specialties      Json?
  city             String?  @db.VarChar(255)
  neighborhood     String?  @db.VarChar(255)
  state            String?  @db.VarChar(255)
  isVerified       Boolean  @default(false) @map("is_verified")
  hourlyRate       Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  averageRating    Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews     Int      @default(0) @map("total_reviews")
  isUrgentAvailable Boolean @default(false) @map("is_urgent_available")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories       ProviderCategory[]
  serviceRequests  ServiceRequest[] @relation("ProviderServiceRequests")

  @@map("provider_profiles")
}

model ProviderCategory {
  providerProfileId String @map("provider_profile_id") @db.VarChar(36)
  categoryId        String @map("category_id") @db.VarChar(36)
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, categoryId])
  @@map("provider_categories")
}

model ServiceRequest {
  id             String        @id @default(uuid()) @db.VarChar(36)
  clientId       String        @map("client_id") @db.VarChar(36)
  providerId     String?       @map("provider_id") @db.VarChar(36)
  categoryId     String        @map("category_id") @db.VarChar(36)
  status         ServiceStatus @default(REQUESTED)
  description    String        @db.Text
  urgencyFlag    Boolean       @default(false) @map("urgency_flag")
  scheduledFor   DateTime?     @map("scheduled_for")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  client         User          @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  provider       User?         @relation("ProviderRequests", fields: [providerId], references: [id], onDelete: SetNull, map: "service_requests_provider_user_fkey")
  providerProfile ProviderProfile? @relation("ProviderServiceRequests", fields: [providerId], references: [userId], onDelete: SetNull, map: "service_requests_provider_profile_fkey")
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  chatRoom       ChatRoom?
  reviews        Review[]

  @@index([clientId, createdAt])
  @@index([providerId, status, createdAt])
  @@map("service_requests")
}

model ChatRoom {
  id               String        @id @default(uuid()) @db.VarChar(36)
  serviceRequestId String?       @unique @map("service_request_id") @db.VarChar(36)
  clientId         String        @map("client_id") @db.VarChar(36)
  providerId       String        @map("provider_id") @db.VarChar(36)
  createdAt        DateTime      @default(now()) @map("created_at")
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  client           User          @relation("ChatClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider         User          @relation("ChatProvider", fields: [providerId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@index([clientId, createdAt])
  @@index([providerId, createdAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id           String      @id @default(uuid()) @db.VarChar(36)
  roomId       String      @map("room_id") @db.VarChar(36)
  senderId     String      @map("sender_id") @db.VarChar(36)
  messageType  MessageType @default(TEXT) @map("message_type")
  content      String      @db.Text
  isRead       Boolean     @default(false) @map("is_read")
  createdAt    DateTime    @default(now()) @map("created_at")
  room         ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model Review {
  id               String        @id @default(uuid()) @db.VarChar(36)
  serviceRequestId String        @map("service_request_id") @db.VarChar(36)
  clientId         String        @map("client_id") @db.VarChar(36)
  providerId       String        @map("provider_id") @db.VarChar(36)
  rating           Int           @db.SmallInt
  comment          String?       @db.Text
  status           ReviewStatus  @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  client           User          @relation("ReviewsGiven", fields: [clientId], references: [id], onDelete: Cascade)
  provider         User          @relation("ReviewsReceived", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId])
  @@index([providerId, status, createdAt])
  @@index([clientId, createdAt])
  @@map("reviews")
}
